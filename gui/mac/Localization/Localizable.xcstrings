    },
    "请粘贴 http(s) 开头的网页链接": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a link that starts with http(s)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "http(s) で始まるリンクを貼り付けてください"
          }
        }
      }
    },
    "跟随「文件、文本、网页」的共用设置；在主窗口调整后，这里同步生效。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows the shared settings of File, Text and Web. Changes made in the main window apply here too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ファイル・テキスト・Web」の共通設定に従います。メインウィンドウでの変更はここにも反映されます。"
          }
        }
      }
    },
    "输入来源": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source"
          }
        },
        "ja": {
          "stringUnit": {
