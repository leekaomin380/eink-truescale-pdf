            "value": "入力元"
          }
        }
      }
    },
    "迁移现有配对": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import Existing Pairing"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のペアリングを移行"
          }
        }
      }
    },
    "运行自检": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run Self-Check"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セルフチェックを実行"
          }
        }
      }
    },
    "这些组件作为独立程序随 App 分发，由 App 启动调用，各自许可不受本项目 MIT 许可影响。pandoc 仅改写了动态库加载路径并重新签名，未修改源代码。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These components ship with the app as separate programs that the app launches; their licenses are unaffected by this project's MIT license. pandoc's dynamic-library load paths were rewritten and the binary re-signed; its source code is unmodified."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのコンポーネントは独立したプログラムとして App に同梱され、App から起動して呼び出します。それぞれのライセンスは本プロジェクトの MIT ライセンスの影響を受けません。pandoc は動的ライブラリの読み込みパスの書き換えと再署名のみを行い、ソースコードは変更していません。"
          }
        }
      }
    },
    "进阶设置": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細設定"
          }
        }
      }
    },
    "连接中…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続中…"
          }
        }
      }
    },
    "通常是快捷指令仍引用已经移动的源码目录。重新复制本页命令并替换旧命令即可。命令使用 App 内置脚本，归档源码不会影响它；移动或重命名 App 后，需要重新复制命令。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usually the shortcut still points to a source folder that has moved. Copy the command on this page again and replace the old one. The command uses the script inside the app, so archived source code does not affect it; after moving or renaming the app, copy the command again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "多くの場合、ショートカットが移動済みのソースフォルダーを参照したままになっています。このページのコマンドをコピーし直して置き換えてください。コマンドは App 内蔵のスクリプトを使うため、ソースのアーカイブは影響しません。App を移動・名前変更した場合はコマンドをコピーし直してください。"
          }
        }
      }
    },
    "通过 USB 或同一局域网直接投递，无需运行 QUADERNO PC App。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivers directly over USB or the local network — the QUADERNO PC App is not needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "USB または同じローカルネットワーク経由で直接送信します。QUADERNO PC App は不要です。"
          }
        }
      }
    },
