          "stringUnit": {
            "state": "translated",
            "value": "このページの本文はスクリプトで読み込まれるため取得できません。ブラウザで本文をコピーし、「テキストを貼り付け」を使ってください。"
          }
        }
      }
    },
    "请先粘贴文本": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste some text first"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にテキストを貼り付けてください"
          }
        }
      }
    },
    "请先粘贴链接": {
      "localizations": {
