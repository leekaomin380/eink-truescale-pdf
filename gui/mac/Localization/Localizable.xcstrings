    "可选，仅 MOBI / AZW 转换需要（GPL-3.0）。未打包。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional; needed only for MOBI / AZW conversion (GPL-3.0). Not bundled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オプション。MOBI / AZW の変換にのみ必要です（GPL-3.0）。同梱していません。"
          }
        }
      }
    },
    "可选，留空自动提取 # 标题": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional — leave empty to use the first # heading"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意。空欄なら最初の # 見出しを使います"
          }
